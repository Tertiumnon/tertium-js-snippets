{
  "name": "tertium-js-snippets",
  "displayName": "Tertium JS Snippets",
  "description": "JavaScript Snippets for Visual Studio Code",
  "publisher": "Tertiumnon",
  "repository": {
    "url": "https://github.com/Tertiumnon/tertium-js-snippets"
  },
  "icon": "images/logo.png",
  "version": "3.0.10",
  "engines": {
    "vscode": "^1.39.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "commit": "cz",
    "md": "node helpers/get-md-snippet-declarations.js",
    "changelog": "npx @tertium/gith changelog",
    "pre:release": "npm run md && npm run changelog",
    "release:patch": "npx @tertium/gith release --patch",
    "release:minor": "npx @tertium/gith release --minor",
    "release:major": "npx @tertium/gith release --major",
    "publish": "vsce package && vsce publish --no-verify"
  },
  "categories": [
    "Snippets"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "devDependencies": {
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "generate-changelog": "^1.8.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@vscode/vsce": "^3.4.2"
  }
}
